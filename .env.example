# SAMS Mark-2 Configuration Template

PROJECT_NAME="SAMS Mark-2 AI Face Attendance Management System"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:CHANGE_PASSWORD@localhost:5432/sams_db"
DATABASE_SYNC_URL="postgresql://postgres:CHANGE_PASSWORD@localhost:5432/sams_db"
DATABASE_FALLBACK_SQLITE=false
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./data/sams_dev.db"

# Security & Secrets (Must be changed in production!)
SECRET_KEY="GENERATE_A_RANDOM_LONG_STRING_HERE"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# AI Models & Storage
MODEL_STORAGE_DIR="./ai_engine/models"
ENROLLMENT_IMAGE_DIR="./data/enrollment_images"

